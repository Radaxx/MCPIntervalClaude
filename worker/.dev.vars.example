# Secrets utilisés par `wrangler dev` en local (fichier lu automatiquement,
# jamais commité). En production, définis ces mêmes clés avec :
#   wrangler secret put INTERVALS_API_KEY
#   wrangler secret put INTERVALS_ATHLETE_ID
#   wrangler secret put OWNER_PASSWORD

INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# Mot de passe personnel demandé par la page /authorize avant d'autoriser
# claude.ai (ou tout autre client MCP) à obtenir un jeton d'accès.
OWNER_PASSWORD=

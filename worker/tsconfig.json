{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true,
    "experimentalDecorators": true
  },
  "include": [
    "src/**/*.ts",
    "../src/client/**/*.ts",
    "../src/tools/**/*.ts",
    "../src/types/**/*.ts",
    "../src/format.ts",
    "../src/mcpResult.ts"
  ]
}
